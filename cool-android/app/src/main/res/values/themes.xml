<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints the whole UI; the platform theme only needs to keep the
         system chrome out of the way and avoid a flash of the wrong colour. -->
    <style name="Theme.HybridDemo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF7F7F9</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
