// Super Ultra ground: one material for the whole island terrain, from the
// campfire clearing down to the seabed.
//
// Splat from world height, slope and the vertex colour the terrain builder
// writes (r = exposed rock, g = worn dirt): lush and dry grass, dirt, dry and
// wet sand, rock with cracks, and rippled seabed sand lit by caustics.
//
// Relief comes from baked tileable normal maps (see procedural_textures.dart)
// rather than per-pixel noise: they are mipmapped, so fine detail filters away
// with distance instead of sparkling.
material {
  name: "IslandGround",
  shading_model: lit,
  parameters: [
    { type: float, name: time, default: 0.0 },
    // x = sea level, y = caustic strength, z = bump strength, w = unused.
    { type: vec4, name: water, default: [-1.35, 1.0, 1.0, 0.0] },
    // rgb = sunlight reaching the seabed (colour * intensity), from Dart.
    { type: vec4, name: caustic_light, default: [1.0, 1.0, 1.0, 1.0] },
    { type: sampler2d, name: detail_normal, hint: default_normal },
    { type: sampler2d, name: sand_normal, hint: default_normal },
    { type: sampler2d, name: masks, hint: default_black },
  ],
}

fragment {
  vec2 RainHash22(vec2 p) {
    vec3 q = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
    q += dot(q, q.yzx + 33.33);
    return fract((q.xx + q.yz) * q.zy);
  }

  // Raindrop rings: in each cell of two offset grids, one ring expands from
  // a random point on its own clock and fades. Returns a slope to add to the
  // surface normal (x, z).
  vec2 RainRings(vec2 p, float time, float scale) {
    vec2 slope = vec2(0.0);
    for (int layer = 0; layer < 2; layer++) {
      vec2 q = p * scale + float(layer) * vec2(0.37, 0.71);
      vec2 cell = floor(q);
      vec2 h = RainHash22(cell + float(layer) * 17.3);
      vec2 d = fract(q) - (0.2 + 0.6 * h);
      float r = length(d);
      float age = fract(time * 1.1 + h.x * 7.13 + h.y * 3.7);
      float x = (r - age * 0.45) / 0.055;
      float fade = (1.0 - age) * (1.0 - age);
      slope += d / max(r, 0.001) * (-2.0 * x * exp(-x * x)) * fade * 0.09;
    }
    return slope;
  }

  // Tangent-space normal onto the surface, with the tangent along world +x
  // and the bitangent along world +z (how procedural_textures.dart bakes).
  vec3 PerturbNormal(vec3 n, vec3 tangent_normal, float strength) {
    vec3 t = normalize(vec3(1.0, 0.0, 0.0) - n * n.x);
    vec3 b = cross(t, n);
    return normalize(n * tangent_normal.z +
                     (t * tangent_normal.x + b * tangent_normal.y) * strength);
  }

  vec3 DecodeNormal(vec4 texel) {
    return texel.xyz * 2.0 - 1.0;
  }

  void Surface(inout MaterialInputs material) {
    vec3 p = GetWorldPosition();
    vec3 geometric = normalize(GetWorldNormal());
    vec4 vertex_color = GetVertexColor();
    float sea = material_params.water.x;
    float time = material_params.time;
    float h = p.y;

    // Screen-space derivatives of world XZ, taken here in uniform control
    // flow. The detail maps below are only fetched where their weight is
    // non-zero (no grass detail on the seabed, no rock normal off rock), and
    // a fetch inside a branch needs explicit gradients to pick its mip.
    vec2 dpdx = dFdx(p.xz);
    vec2 dpdy = dFdy(p.xz);

    // Masks at three scales: continent-sized colour drift, patch-sized
    // variation, and fine grain.
    vec4 macro = texture(masks, p.xz * 0.0071 + vec2(0.13, 0.71));
    vec4 patches = texture(masks, p.xz * 0.043 + vec2(0.61, 0.27));
    vec4 grain = texture(masks, p.xz * 0.37);

    float slope = 1.0 - geometric.y;
    // smoothstep is only defined for edge0 < edge1 (GLSL ES leaves the
    // reverse undefined), so falling edges are written as 1 - smoothstep.
    float under = 1.0 - smoothstep(sea - 0.15, sea + 0.05, h);
    float wet = (1.0 - under) *
                (1.0 - smoothstep(sea + 0.03, sea + 0.45 + 0.2 * patches.g, h));
    float sand = 1.0 - smoothstep(-0.24, -0.07, h + (patches.g - 0.5) * 0.12);
    float rock = clamp(max(vertex_color.r * smoothstep(0.2, 0.55,
                                                       vertex_color.r + grain.r * 0.35),
                           smoothstep(0.5, 0.78, slope)),
                       0.0, 1.0);
    float dirt = vertex_color.g *
                 smoothstep(0.15, 0.55, vertex_color.g + (grain.g - 0.5) * 0.55);
    dirt *= 1.0 - sand;
    float grass = (1.0 - sand) * (1.0 - rock) * (1.0 - dirt);

    // Detail maps, each only where it carries weight. The defaults are what
    // a zero weight makes of them anyway (flat normal, no cavity).
    float lawn = grass + dirt;
    vec4 clumps = vec4(0.5, 0.5, 1.0, 1.0);
    vec3 clump_normal = vec3(0.0, 0.0, 1.0);
    if (lawn > 0.0) {
      clumps = textureGrad(detail_normal, p.xz * 0.61, dpdx * 0.61, dpdy * 0.61);
      vec4 clumps_fine = textureGrad(detail_normal, p.xz * 1.93 + vec2(0.37, 0.11),
                                     dpdx * 1.93, dpdy * 1.93);
      clump_normal = normalize(DecodeNormal(clumps) +
                               DecodeNormal(clumps_fine) * vec3(0.8, 0.8, 0.0));
    }
    vec4 ripples = vec4(0.5, 0.5, 1.0, 0.0);
    if (sand > 0.0) {
      // Rotate the ripple tile so its crests do not line up with the world
      // axes.
      mat2 spin = mat2(0.8, -0.6, 0.6, 0.8);
      ripples = textureGrad(sand_normal, spin * p.xz * 0.52,
                            spin * dpdx * 0.52, spin * dpdy * 0.52);
    }

    // ---- Albedo (linear) ----
    float cavity = clumps.a;
    vec3 lush = vec3(0.060, 0.235, 0.045);
    vec3 dry = vec3(0.185, 0.215, 0.060);
    vec3 grass_color = mix(lush, dry, smoothstep(0.35, 0.75, patches.g * 0.7 + macro.g * 0.5));
    grass_color *= (0.72 + 0.5 * grain.g) * mix(0.62, 1.0, cavity);

    vec3 dirt_color = vec3(0.19, 0.12, 0.065) * (0.8 + 0.4 * grain.g);
    dirt_color = mix(dirt_color, vec3(0.30, 0.26, 0.21), grain.a * 0.8);

    vec3 sand_color = vec3(0.60, 0.49, 0.32) * (0.9 + 0.2 * grain.g) *
                      (0.9 + 0.1 * ripples.a);
    sand_color = mix(sand_color, vec3(0.42, 0.40, 0.36), grain.a * 0.55);
    vec3 wet_sand = sand_color * vec3(0.52, 0.54, 0.58);
    vec3 sea_sand = vec3(0.56, 0.50, 0.37) * (0.85 + 0.25 * ripples.a);

    vec3 rock_color = vec3(0.27, 0.26, 0.245) * (0.75 + 0.45 * patches.g);
    // Cracks on exposed rock only: silt fills them under water, where a
    // crack net reads as dried mud.
    float cracks = grain.r * (1.0 - 0.85 * under);
    rock_color *= 1.0 - 0.6 * cracks;
    // Moisture stain on rock near the waterline.
    rock_color *= mix(1.0, 0.6, 1.0 - smoothstep(sea, sea + 0.6, h));

    vec3 albedo = grass_color * grass + dirt_color * dirt;
    vec3 shore = mix(mix(sand_color, wet_sand, wet), sea_sand, under);
    albedo += shore * sand * (1.0 - rock);
    albedo = mix(albedo, rock_color, rock);

    // ---- Roughness ----
    float roughness = 0.92 * grass + 0.95 * dirt;
    roughness += sand * (1.0 - rock) * mix(mix(0.88, 0.18, wet), 0.6, under);
    roughness = mix(roughness, 0.72, rock);

    // ---- Relief ----
    float bump = material_params.water.z;
    vec3 n = geometric;
    if (lawn > 0.0) {
      n = PerturbNormal(n, clump_normal, bump * (grass * 0.9 + dirt * 0.7));
    }
    if (sand > 0.0) {
      n = PerturbNormal(n, DecodeNormal(ripples),
                        bump * sand * (1.0 - wet * 0.6) * (1.0 - rock) * 0.8);
    }
    if (rock > 0.0) {
      vec3 rock_normal = DecodeNormal(textureGrad(
          detail_normal, p.xz * 0.27 + vec2(0.5, 0.2), dpdx * 0.27, dpdy * 0.27));
      n = PerturbNormal(n, rock_normal, bump * rock * 1.3);
    }

    // Rain (water.w): darker, shinier ground, and puddles in the low spots of
    // the dirt and lawn, ringed by drops.
    float rain_wet = material_params.water.w * (1.0 - under);
    if (rain_wet > 0.001) {
      float low = 1.0 - smoothstep(0.2, 0.34, macro.g + 0.25 * patches.g);
      float puddle = rain_wet * low * clamp(dirt + 0.35 * grass, 0.0, 1.0) *
                     (1.0 - rock) * (1.0 - sand);
      albedo *= mix(1.0, 0.62, rain_wet);
      albedo *= mix(1.0, 0.55, puddle);
      roughness = mix(roughness, roughness * 0.65, rain_wet);
      roughness = mix(roughness, 0.1, puddle);
      vec2 rings = RainRings(p.xz, time, 3.0) * puddle;
      n = normalize(mix(n, geometric, puddle) + vec3(rings.x, 0.0, rings.y));
    }

    material.base_color = vec4(albedo, 1.0);
    material.normal = n;
    material.metallic = 0.0;
    material.roughness = clamp(roughness, 0.05, 1.0);
    material.occlusion = mix(1.0, mix(0.55, 1.0, cavity), grass + dirt * 0.5) *
                         (1.0 - 0.45 * cracks * rock);

    // ---- Caustics on everything under water ----
    if (under > 0.0) {
      // Cells of roughly 0.3 m, like caustics under a light chop. From a
      // distance they average out, so fade them rather than let them alias
      // into a coarse web.
      vec2 drift_a = vec2(time * 0.05, time * 0.031);
      vec2 drift_b = vec2(-time * 0.04, time * 0.047);
      float layer_a = textureGrad(masks, p.xz * 0.53 + drift_a,
                                  dpdx * 0.53, dpdy * 0.53).b;
      float layer_b = textureGrad(masks, p.xz * 0.42 + drift_b + vec2(0.5, 0.3),
                                  dpdx * 0.42, dpdy * 0.42).b;
      float caustic = min(layer_a, layer_b) * 1.6 + layer_a * layer_b * 0.8;
      float view_fade = 1.0 - smoothstep(12.0, 45.0, length(v_viewvector));
      float depth_fade = exp(-(sea - h) * 0.22) * view_fade;
      material.emissive = albedo * caustic * depth_fade * under *
                          material_params.caustic_light.rgb *
                          material_params.water.y;
    }
  }
}
