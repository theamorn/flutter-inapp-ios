// The bed of glowing coals under the campfire logs: dark ash with orange
// cracks that breathe. Drawn on a small disc lying on the ground.
material {
  name: "EmberBed",
  shading_model: lit,
  blending: alpha,
  parameters: [
    { type: float, name: time, default: 0.0 },
    // xy = disc centre (world XZ), z = radius, w = heat (0 = out, 1 = full).
    { type: vec4, name: bed, default: [0.0, -0.45, 0.5, 1.0] },
  ],
}

fragment {
  // Local hash noise rather than <noise.glsl>, whose large constant tables
  // fail to link on some GLES drivers (see island_sky.fmat).
  float Hash12(vec2 p) {
    vec3 q = fract(vec3(p.xyx) * 0.1031);
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
  }

  vec2 Hash22(vec2 p) {
    vec3 q = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
    q += dot(q, q.yzx + 33.33);
    return fract((q.xx + q.yz) * q.zy);
  }

  // Value noise, -1..1.
  float ValueNoise2(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    float a = Hash12(i);
    float b = Hash12(i + vec2(1.0, 0.0));
    float c = Hash12(i + vec2(0.0, 1.0));
    float d = Hash12(i + vec2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y) * 2.0 - 1.0;
  }

  // Worley F2 - F1 in cell units: near 0 on the borders between cells.
  float WorleyBorder2(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    float f1 = 8.0;
    float f2 = 8.0;
    for (int y = -1; y <= 1; y++) {
      for (int x = -1; x <= 1; x++) {
        vec2 cell = vec2(float(x), float(y));
        float d = length(cell + Hash22(i + cell) - f);
        if (d < f1) {
          f2 = f1;
          f1 = d;
        } else if (d < f2) {
          f2 = d;
        }
      }
    }
    return f2 - f1;
  }

  void Surface(inout MaterialInputs material) {
    vec2 q = GetWorldPosition().xz - material_params.bed.xy;
    float radius = material_params.bed.z;
    float heat = material_params.bed.w;
    float time = material_params.time;
    float r = length(q) / radius;
    float edge_noise = ValueNoise2(q * 7.0 + 17.0) * 0.18;
    float coverage = 1.0 - smoothstep(0.7, 1.0, r + edge_noise);

    float coals = WorleyBorder2(q * 11.0);
    float cracks = 1.0 - smoothstep(0.02, 0.16, coals);
    float breathe = 0.55 + 0.45 * ValueNoise2(q * 5.0 + vec2(time * 0.7, -time * 0.45) + 3.0);
    float core = 1.0 - smoothstep(0.1, 0.85, r);

    vec3 ash = mix(vec3(0.035, 0.03, 0.028), vec3(0.16, 0.15, 0.14),
                   smoothstep(0.45, 1.0, r));
    vec3 glow = vec3(4.2, 1.15, 0.22) * (0.25 * core + cracks * (0.6 + core)) *
                breathe * heat;

    material.base_color = vec4(ash, coverage);
    material.metallic = 0.0;
    material.roughness = 0.95;
    material.specular = 0.2;
    material.emissive = glow;
  }
}
