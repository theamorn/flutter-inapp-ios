// Super Ultra sea: clear water you can see the seabed through.
//
// Vertex: four Gerstner waves, the exact WaterSurfaceComponent formula, fed
// from lib/tabs/scene/super_ultra/ocean_waves.dart so buoys on the CPU ride
// the same surface (a unit test pins the two together).
//
// Fragment: refracts the opaque scene behind the surface (scene_color),
// tints it by how much water it passed through (scene_depth, Beer-Lambert),
// mirrors the scene above it (planar_reflection), and mixes the two by
// Fresnel. Foam gathers where the water is thin (the surf line) and on crests.
// The water's own colour goes in `emissive`; `specular` hands reflection
// back to the engine's IBL whenever no planar capture is bound (e.g. inside
// another capture).
material {
  name: "IslandOcean",
  shading_model: lit,
  blending: alpha,
  culling: back,
  // No depth write: a depth-writing translucent is patched into the prepass
  // depth (TranslucentDepthPatchPass), so scene_depth would return the water
  // surface itself and every pixel would read as zero-thickness water.
  depth_write: false,
  engine_inputs: [scene_color, scene_depth, planar_reflection],
  parameters: [
    { type: float, name: time, default: 0.0 },
    // Column i: (dir.x, dir.z, amplitude, k) of wave i.
    { type: mat4, name: wave_shape },
    // Column i: (omega, q * amplitude, q * k * amplitude, 0) of wave i.
    { type: mat4, name: wave_motion },
    // x = fade start radius, y = fade end radius (waves), z/w = alpha fade.
    { type: vec4, name: fade, default: [70.0, 150.0, 250.0, 318.0] },
    // Linear body colours of shallow and deep water (before lighting).
    { type: vec4, name: shallow_color, default: [0.03, 0.30, 0.30, 1.0] },
    { type: vec4, name: deep_color, default: [0.004, 0.035, 0.075, 1.0] },
    // rgb = absorption per metre, w = in-scatter density per metre.
    { type: vec4, name: absorption, default: [0.42, 0.075, 0.05, 0.11] },
    // rgb = light reaching the water body (sun + sky), set from Dart.
    { type: vec4, name: water_light, default: [1.0, 1.0, 1.0, 1.0] },
    // x = ripple strength, y = refraction strength, z = reflection distortion.
    { type: vec4, name: ripple, default: [0.34, 0.06, 0.018, 0.0] },
    // x = surf-line width (m), y = crest foam height, z = foam amount.
    { type: vec4, name: foam, default: [0.55, 0.13, 1.0, 0.0] },
    { type: sampler2d, name: ripple_normal, hint: default_normal },
    { type: sampler2d, name: foam_texture, hint: default_black },
  ],
  varyings: [
    { type: float, name: v_crest },
  ],
}

vertex {
  void GerstnerWave(vec4 shape, vec4 motion, vec2 p, float time,
                    inout vec3 displacement, inout vec3 tangent,
                    inout vec3 binormal) {
    if (shape.z <= 0.0) {
      return;
    }
    float phase = shape.w * dot(shape.xy, p) - motion.x * time;
    float c = cos(phase);
    float s = sin(phase);
    displacement += vec3(motion.y * shape.x * c, shape.z * s,
                         motion.y * shape.y * c);
    float ka = shape.w * shape.z;
    tangent += vec3(-motion.z * shape.x * shape.x * s, shape.x * ka * c,
                    -motion.z * shape.x * shape.y * s);
    binormal += vec3(-motion.z * shape.x * shape.y * s, shape.y * ka * c,
                     -motion.z * shape.y * shape.y * s);
  }

  void Vertex(inout VertexInputs vertex) {
    vec2 p = vertex.world_position.xz;
    float time = material_params.time;
    vec3 displacement = vec3(0.0);
    vec3 tangent = vec3(1.0, 0.0, 0.0);
    vec3 binormal = vec3(0.0, 0.0, 1.0);
    GerstnerWave(material_params.wave_shape[0], material_params.wave_motion[0],
                 p, time, displacement, tangent, binormal);
    GerstnerWave(material_params.wave_shape[1], material_params.wave_motion[1],
                 p, time, displacement, tangent, binormal);
    GerstnerWave(material_params.wave_shape[2], material_params.wave_motion[2],
                 p, time, displacement, tangent, binormal);
    GerstnerWave(material_params.wave_shape[3], material_params.wave_motion[3],
                 p, time, displacement, tangent, binormal);
    // Far out the grid is too coarse to carry the waves; fade them so they do
    // not alias into noise at the horizon.
    float keep = 1.0 - smoothstep(material_params.fade.x, material_params.fade.y,
                                  length(p));
    displacement *= keep;
    vec3 normal = normalize(cross(binormal, tangent));
    vertex.world_position += displacement;
    vertex.world_normal = normalize(mix(vec3(0.0, 1.0, 0.0), normal, keep));
    v_crest = displacement.y;
  }
}

fragment {
  vec2 RainHash22(vec2 p) {
    vec3 q = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
    q += dot(q, q.yzx + 33.33);
    return fract((q.xx + q.yz) * q.zy);
  }

  // Raindrop rings: in each cell of two offset grids, one ring expands from
  // a random point on its own clock and fades. Returns a slope to add to the
  // surface normal (x, z).
  vec2 RainRings(vec2 p, float time, float scale) {
    vec2 slope = vec2(0.0);
    for (int layer = 0; layer < 2; layer++) {
      vec2 q = p * scale + float(layer) * vec2(0.37, 0.71);
      vec2 cell = floor(q);
      vec2 h = RainHash22(cell + float(layer) * 17.3);
      vec2 d = fract(q) - (0.2 + 0.6 * h);
      float r = length(d);
      float age = fract(time * 1.1 + h.x * 7.13 + h.y * 3.7);
      float x = (r - age * 0.45) / 0.055;
      float fade = (1.0 - age) * (1.0 - age);
      slope += d / max(r, 0.001) * (-2.0 * x * exp(-x * x)) * fade * 0.09;
    }
    return slope;
  }

  float SchlickFresnel(float cos_theta) {
    return 0.02 + 0.98 * pow(1.0 - cos_theta, 5.0);
  }

  // The planar capture at this surface point, with a screen-space nudge so
  // ripples break the mirror up. a == 0 when no capture is bound.
  vec4 SamplePlanarReflection(vec3 world_position, vec2 distortion) {
    if (planar_reflection_info.params.x < 0.5) {
      return vec4(0.0);
    }
    vec4 clip = planar_reflection_info.view_projection *
                vec4(world_position, 1.0);
    if (clip.w <= 0.0) {
      return vec4(0.0);
    }
    vec2 uv = vec2(0.5 + 0.5 * clip.x / clip.w, 0.5 - 0.5 * clip.y / clip.w);
    uv = clamp(uv + distortion, vec2(0.001), vec2(0.999));
    return vec4(texture(planar_reflection, uv).rgb, 1.0);
  }

  void Surface(inout MaterialInputs material) {
    vec3 p = GetWorldPosition();
    float time = material_params.time;
    float view_distance = length(v_viewvector);
    vec3 view = GetViewDirection();

    // Ripples: two scrolling layers of the tileable wave normal map.
    float near = 1.0 - smoothstep(20.0, 90.0, view_distance);
    vec2 uv_a = p.xz * 0.085 + vec2(time * 0.021, time * 0.012);
    vec2 uv_b = p.xz * 0.029 + vec2(-time * 0.010, time * 0.015);
    vec3 ripple_a = texture(ripple_normal, uv_a).xyz * 2.0 - 1.0;
    vec3 ripple_b = texture(ripple_normal, uv_b).xyz * 2.0 - 1.0;
    vec2 slope = (ripple_a.xy * 0.6 + ripple_b.xy) * material_params.ripple.x *
                 mix(0.3, 1.0, near);
    // Rain: rings across the whole sea (ripple.w is how hard it rains),
    // faded out with distance; past 90 m they would be multiplied by zero.
    float rain = material_params.ripple.w;
    if (rain > 0.001 && near > 0.0) {
      slope += RainRings(p.xz, time, 2.3) * rain * near;
    }
    vec3 normal = normalize(normalize(GetWorldNormal()) +
                            vec3(slope.x, 0.0, slope.y));

    float n_dot_v = clamp(dot(normal, view), 0.0, 1.0);
    float fresnel = SchlickFresnel(n_dot_v);

    // How much water lies behind this fragment, along the view axis. The
    // refraction offset is dropped where it would pull in something in front
    // of the water (the classic refraction halo around a shoreline object).
    float surface_depth = GetFragmentViewDepth();
    vec2 refraction = slope * material_params.ripple.y;
    float scene_depth = GetSceneDepth(refraction);
    if (scene_depth < surface_depth) {
      refraction = vec2(0.0);
      scene_depth = GetSceneDepth(vec2(0.0));
    }
    float thickness = max(scene_depth - surface_depth, 0.0);
    refraction *= clamp(thickness * 0.6, 0.0, 1.0);
    vec3 behind = GetSceneColor(refraction);

    vec3 transmittance = exp(-material_params.absorption.rgb * thickness);
    float inscatter = 1.0 - exp(-material_params.absorption.w * thickness);
    vec3 body = mix(material_params.shallow_color.rgb,
                    material_params.deep_color.rgb,
                    smoothstep(1.5, 14.0, thickness)) *
                material_params.water_light.rgb;
    vec3 refracted = behind * transmittance + body * inscatter;

    vec4 planar = SamplePlanarReflection(p, slope * material_params.ripple.z *
                                                (1.0 + 4.0 * near));
    vec3 water = mix(refracted, planar.rgb, fresnel * planar.a);

    // Foam: a lace pattern (the caustic web, scrolled) gathered along the
    // surf line and on the tallest crests. Most of the sea has neither, so
    // the two foam fetches only happen where foam can be non-zero, with
    // explicit gradients (taken in uniform flow) for the mip.
    vec2 dpdx = dFdx(p.xz);
    vec2 dpdy = dFdy(p.xz);
    float surf = 1.0 - smoothstep(0.0, material_params.foam.x, thickness);
    float crest = smoothstep(material_params.foam.y,
                             material_params.foam.y + 0.09, v_crest);
    float foam = 0.0;
    if ((surf > 0.0 || crest > 0.0) && near > 0.0) {
      float lace = textureGrad(foam_texture,
                               p.xz * 0.33 + vec2(time * 0.031, -time * 0.018),
                               dpdx * 0.33, dpdy * 0.33).b;
      float breakup = textureGrad(foam_texture,
                                  p.xz * 0.91 - vec2(time * 0.047, 0.0),
                                  dpdx * 0.91, dpdy * 0.91).g;
      foam = (surf * (0.35 + 1.1 * lace) + crest * lace * 1.4) *
             smoothstep(0.25, 0.65, breakup + surf * 0.45);
      foam = clamp(foam * material_params.foam.z * near, 0.0, 1.0);
    }

    // Feather the waterline so the sand shows through instead of a hard
    // intersection line, and fade the far rim into the sky.
    float radius = length(p.xz);
    float edge = smoothstep(0.0, 0.05, thickness);
    float far_fade = 1.0 - smoothstep(material_params.fade.z,
                                      material_params.fade.w, radius);

    material.base_color = vec4(vec3(0.92) * foam, edge * far_fade);
    material.normal = normal;
    material.metallic = 0.0;
    material.roughness = mix(0.05, 0.85, foam);
    material.specular = mix(1.0, 0.0, planar.a) * (1.0 - foam);
    material.emissive = water * (1.0 - foam);
  }
}
